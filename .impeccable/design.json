  "narrative": {
    "northStar": "Studovna",
    "overview": "A calm place to return to a learning decision. Warm paper, clear ink, generous separation, and a restrained teal action give the authored exercise priority. The supplied guide adds encouragement at welcome, continuation, and completion; real lesson content and learner state provide the substance.\n\nThis is the implemented system from the approved Pen.dev boards `V7mUpG`, `QB1gf`, `liRhy`, and `mAWd8`. The onboarding extension follows `wKThC` (desktop), `Ui4uz` (mobile), `Z9Mlw` (plans), `XFfjW` (components), and `V507P` (guide library). Its current application is `.investi-theme` on `/learn`, `/onboarding`, and `/onboarding/plan`. Other product routes and focused lessons retain the existing Nunito-based theme during the staged migration. The legacy palette and typography in AGENTS.md are not additional tokens for this scoped system.",
    "keyCharacteristics": [
      "Warm paper with crisp, readable text.",
      "One dominant learning action and quieter supporting context.",
      "Manrope headings with Inter controls and explanation.",
      "Real state, explicit feedback, and intentional mobile reflow."
    ],
    "rules": [
      {
        "name": "The Two Teals Rule",
        "body": "Use Action Teal for readable interaction and Graphic Teal for progress or graphics; preserve their separate semantic roles.",
        "section": "colors"
      },
      {
        "name": "The Scoped Type Rule",
        "body": "Apply the new font pairing through the paper theme; do not globally rewrite focused lessons or unconverted routes as part of Studovna work.",
        "section": "typography"
      },
      {
        "name": "The Quiet Depth Rule",
        "body": "Use surfaces and hierarchy first; shadows should clarify layering rather than decorate every section.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve semantic token roles and visible focus.",
      "Do let the authored learning interaction and its next step dominate.",
      "Do pair feedback and data color with explanation, labels, or icons.",
      "Do preserve the supplied guide assets and their [manifest provenance](public/investi-assets/manifest.json).",
      "Do retain the scoped migration boundary until another route is deliberately converted."
    ],
    "donts": [
      "Don't turn supporting content into an equal-priority dashboard card grid.",
      "Don't replace unavailable data with invented portfolio graphics or zero values.",
      "Don't add glow, gradient text, trading-terminal styling, or decorative finance objects.",
      "Don't shrink essential text to solve responsive overflow.",
      "Don't change lesson completion, auth, financial accounting, rewards, persistence, or server authority during visual work."
    ]
  }
}
