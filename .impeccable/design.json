      "html": "<button class=\"ds-primary\" disabled aria-busy=\"true\">Ukládám…<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:52px;padding:12px 22px;border:0;border-radius:var(--radius-control);background:var(--color-primary);color:white;font-family:var(--font-investi-inter,Inter),sans-serif;font-size:1rem;font-weight:600;line-height:1.5;text-align:center;cursor:pointer;transition:background-color 160ms ease-out}.ds-primary:hover{background:var(--color-primary-hover)}.ds-primary:active{background:var(--color-primary-pressed)}.ds-primary:focus-visible{outline:3px solid var(--color-foreground);outline-offset:4px;}.ds-primary:disabled{background:var(--color-track);color:var(--color-disabled);cursor:wait}@media(prefers-reduced-motion:reduce){.ds-primary{transition-duration:0s!important}}"
    },
    {
      "name": "Answer Option",
      "kind": "input",
      "refersTo": "answer-option",
      "description": "A labeled native radio with whole-option keyboard focus; the selected example shows correct feedback.",
      "html": "<fieldset class=\"ds-answers\"><legend class=\"ds-legend\">Vyber odpověď a uvidíš vysvětlení</legend><label class=\"ds-answer ds-correct\"><span class=\"ds-key\" aria-hidden=\"true\">A</span><span>Odpověď z autorské lekce</span><input type=\"radio\" name=\"ds-answer-choice\" checked aria-label=\"Odpověď z autorské lekce\"/><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m8 12 3 3 5-6\"/></svg></label><label class=\"ds-answer\"><span class=\"ds-key\" aria-hidden=\"true\">B</span><span>Další odpověď</span><input type=\"radio\" name=\"ds-answer-choice\" aria-label=\"Další odpověď\"/></label></fieldset>",
      "css": ".ds-answers{display:grid;gap:10px;border:0;padding:0;margin:0}.ds-legend{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.ds-answer{position:relative;display:flex;align-items:center;gap:14px;min-height:55px;padding:16px 20px;border:1px solid var(--color-border-strong);border-radius:var(--radius-control);background:var(--color-surface);color:var(--color-foreground);font-family:var(--font-investi-inter,Inter),sans-serif;font-size:1rem;line-height:1.45;cursor:pointer}.ds-answer>span:nth-child(2){flex:1;min-width:0}.ds-key{font-size:.8125rem;font-weight:600;color:var(--color-muted)}.ds-answer input{appearance:none;order:3;width:20px;height:20px;flex:none;border:1.5px solid var(--color-border-strong);border-radius:50%;background:var(--color-surface)}.ds-answer input:checked{border-color:var(--color-primary)}.ds-answer:has(input:focus-visible){outline:3px solid var(--color-foreground);outline-offset:3px}.ds-answer input:focus-visible{outline:none}.ds-answer>svg{position:absolute;right:20px;background:var(--color-primary-soft);color:var(--color-primary);pointer-events:none}.ds-correct{border-color:var(--color-primary);background:var(--color-primary-soft)}"
    },
    {
      "name": "Supporting Card",
      "kind": "card",
      "refersTo": "card",
      "description": "A restrained supporting surface with an eyebrow, title, and real-state explanation.",
      "html": "<section class=\"ds-card\"><p class=\"ds-eyebrow\">Tvůj pokrok</p><h3>Učení není závod.</h3><p class=\"ds-description\">K hotovým lekcím se můžeš vracet vlastním tempem.</p></section>",
      "css": ".ds-card{border:1px solid var(--color-border);border-radius:var(--radius-surface);background:var(--color-surface);padding:28px;color:var(--color-foreground);font-family:var(--font-investi-inter,Inter),sans-serif;}.ds-eyebrow{margin:0;color:var(--color-primary);font-size:.75rem;line-height:1.2;font-weight:600;letter-spacing:.083em;text-transform:uppercase}.ds-card h3{margin:22px 0 0;font-family:var(--font-investi-manrope,Manrope),sans-serif;font-weight:600;letter-spacing:-.03em;font-size:1.625rem;line-height:1.35}.ds-description{margin:6px 0 0;color:var(--color-muted);font-size:.875rem;line-height:1.5}"
    },
    {
      "name": "Desktop Navigation",
      "kind": "nav",
      "description": "Existing destinations with a quiet active underline and keyboard focus.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Hlavní navigace\"><a href=\"/learn\" aria-current=\"page\">Učení</a><a href=\"/lab\">Portfolio Lab</a><a href=\"/progress\">Pokrok</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:36px;font-family:var(--font-investi-inter,Inter),sans-serif;font-size:.875rem}.ds-nav a{position:relative;display:flex;align-items:center;min-height:48px;color:var(--color-foreground);font-weight:500;text-decoration:none}.ds-nav a[aria-current]{font-weight:600}.ds-nav a[aria-current]::after{content:\"\";position:absolute;inset-inline:0;bottom:4px;height:2px;border-radius:999px;background:var(--color-primary)}.ds-nav a:focus-visible{outline:3px solid var(--color-foreground);outline-offset:4px;}"
    },
    {
      "name": "Chapter Disclosure",
      "kind": "custom",
      "description": "Native disclosure semantics with a numbered chapter, structured lesson link, and title reflow below 18rem.",
      "html": "<details class=\"ds-chapter\" open><summary><span class=\"ds-number\">01</span><span class=\"ds-chapter-name\">Základy investování<small>Uložený postup v kapitole</small></span><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></summary><a class=\"ds-lesson\" href=\"/learn\">Vrátit se k autorské lekci<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></a></details>",
      "css": ".ds-chapter{container-type:inline-size;container-name:ds-chapter;border:1px solid var(--color-border);border-radius:var(--radius-surface);background:var(--color-surface);padding:16px 8px;color:var(--color-foreground);font-family:var(--font-investi-inter,Inter),sans-serif;}.ds-chapter summary{display:flex;align-items:center;gap:16px;padding-inline:8px;min-height:48px;list-style:none;cursor:pointer}.ds-chapter summary::-webkit-details-marker{display:none}.ds-number{font-family:var(--font-investi-manrope,Manrope),sans-serif;font-weight:600;letter-spacing:-.036em;font-size:2.25rem;line-height:1;color:var(--color-primary)}.ds-chapter-name{flex:1;min-width:0;font-family:var(--font-investi-manrope,Manrope),sans-serif;font-weight:600;letter-spacing:-.03em;font-size:1.3125rem;line-height:1.1}.ds-chapter-name small{display:block;margin-top:4px;font-family:var(--font-investi-inter,Inter),sans-serif;font-size:.8125rem;font-weight:400;line-height:1.5;letter-spacing:normal;color:var(--color-muted)}.ds-chapter[open] summary>svg{transform:rotate(180deg)}.ds-chapter summary:focus-visible{outline:3px solid var(--color-foreground);outline-offset:4px;}.ds-lesson{display:flex;align-items:center;justify-content:space-between;gap:14px;min-height:64px;padding:13px 12px;margin-top:16px;border-radius:var(--radius-control);color:var(--color-foreground);font-size:.9375rem;line-height:1.4;text-decoration:none}.ds-lesson:hover{background:var(--color-surface-practice)}.ds-lesson:focus-visible{outline:3px solid var(--color-foreground);outline-offset:4px;}@container ds-chapter (width < 18rem){.ds-chapter summary{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px}.ds-number{grid-column:1;grid-row:1}.ds-chapter summary>svg{grid-column:2;grid-row:1}.ds-chapter-name{grid-column:1/-1;grid-row:2;overflow-wrap:normal;hyphens:auto}}"
