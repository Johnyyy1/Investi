      "name": "Primary Action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The dominant continuation action, with hover, press, and visible focus.",
      "html": "<button class=\"ds-primary\">Pokračovat v lekci<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:52px;padding:12px 22px;border:0;border-radius:var(--radius-control);background:var(--color-primary);color:white;font-family:var(--font-investi-inter,Inter),sans-serif;font-size:1rem;font-weight:600;line-height:1.5;text-align:center;cursor:pointer;transition:background-color 160ms ease-out}.ds-primary:hover{background:var(--color-primary-hover)}.ds-primary:active{background:var(--color-primary-pressed)}.ds-primary:focus-visible{outline:3px solid var(--color-foreground);outline-offset:4px;}.ds-primary:disabled{background:var(--color-track);color:var(--color-disabled);cursor:wait}@media(prefers-reduced-motion:reduce){.ds-primary{transition-duration:0s!important}}"
    },
    {
      "name": "Pending Action",
      "kind": "button",
      "refersTo": "button-primary-pending",
