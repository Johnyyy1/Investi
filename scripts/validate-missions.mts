import "dotenv/config";
import assert from "node:assert/strict";
import { copyFile, mkdir, mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { randomUUID } from "node:crypto";
import postgres from "postgres";
import { drizzle } from "drizzle-orm/postgres-js";
import { migrate } from "drizzle-orm/postgres-js/migrator";
import type { StepDefinition } from "../src/features/lessons/types";

const url = new URL(process.env.DATABASE_URL!);
assert.ok(["localhost", "127.0.0.1", "[::1]"].includes(url.hostname));
assert.equal(url.pathname, "/investi_missions_qa");
assert.equal(process.env.MISSIONS_QA_DISPOSABLE, "1");
assert.equal(process.env.MARKET_DATA_PROVIDER, "deterministic");
const sql = postgres(url.toString(), { prepare: false, onnotice: () => {} });
// Prove an earlier checkout's locally applied 0019 mission table survives the new main chain.
const baseline = await mkdtemp(join(tmpdir(), "investi-mission-baseline-"));
const upgradeOwner = `mission_upgrade_${randomUUID()}`;
try {
  const journal = JSON.parse(await readFile("drizzle/meta/_journal.json", "utf8"));
  journal.entries = journal.entries.filter((entry: { idx: number }) => entry.idx < 21);
  await mkdir(join(baseline, "meta"));
  await writeFile(join(baseline, "meta/_journal.json"), JSON.stringify(journal));
  await Promise.all(journal.entries.map((entry: { tag: string }) => copyFile(`drizzle/${entry.tag}.sql`, join(baseline, `${entry.tag}.sql`))));
  await migrate(drizzle(sql), { migrationsFolder: baseline });
  const [existing] = await sql`select to_regclass('public.mission_attempt') as name`;
  if (!existing.name) await sql.unsafe(await readFile("scripts/fixtures/missions-0019-preview.sql", "utf8"));
  await sql`insert into "user"(id,name,email,created_at,updated_at) values(${upgradeOwner},'Upgrade QA',${`${upgradeOwner}@example.com`},now(),now())`;
  await sql`insert into mission_attempt(id,user_id,mission_id,request_id,evidence,completed) values(${randomUUID()},${upgradeOwner},'allocation-training-v1','old-request','{"source":"earlier-checkout"}'::jsonb,true)`;
  const before = await sql`select * from mission_attempt where user_id=${upgradeOwner}`;
  await migrate(drizzle(sql), { migrationsFolder: "drizzle" });
  await migrate(drizzle(sql), { migrationsFolder: "drizzle" });
  assert.deepEqual(await sql`select * from mission_attempt where user_id=${upgradeOwner}`, before);
} finally {
  await rm(baseline, { recursive: true, force: true });
  await sql`delete from "user" where id=${upgradeOwner}`;
}
const { db } = await import("../src/db");
const { seedCurriculum } = await import("../src/db/curriculum");
await seedCurriculum(db);
const ids = Array.from({ length: 4 }, () => `mission_qa_${randomUUID()}`);
const [owner, other, personal, guest] = ids;
const { authoredLessons } = await import("../src/features/lessons/registry");
const { getStepDefinitions } = await import("../src/features/lessons/steps");
const { missionPreviewBlocks, missionPreviewSteps } = await import("../src/features/missions/test-fixtures");
const lesson = authoredLessons.find((item) => item.id === "foundations-portfolio")!;
const originalBlocks = lesson.blocks;
const steps = getStepDefinitions(lesson.id) as StepDefinition[];
const originalSteps = [...steps];
lesson.blocks = missionPreviewBlocks; steps.splice(0, steps.length, ...missionPreviewSteps);
const decision = { allocation: { svet: 80, tech: 0, cip: 0, energie: 0, banka: 0, leky: 0 }, prediction: "fail" };
try {
  for (const id of ids) await sql`insert into "user"(id,name,email,created_at,updated_at) values(${id},'Mission QA',${`${id}@example.com`},now(),now())`;
  await sql`update "user" set is_anonymous=true, anonymous_kind='guest' where id=${guest}`;
  const { verifyMission, hasCompletedMission } = await import("../src/features/missions/repository");
  const { saveLessonProgress: save, completeLesson } = await import("../src/features/progress/repository");
  const advance = (answers?: Record<string, string>) => save(owner, { lessonId: lesson.id, status: "in_progress", lastPosition: 1 }, answers);
  await assert.rejects(() => advance({ completed: "true", missionId: "allocation-training-v1" }));
  await verifyMission(other, "allocation-training-v1", randomUUID(), decision);
  await assert.rejects(() => advance(), "another owner's attempt cannot satisfy a mission");
  await verifyMission(owner, "diversification-rules-v1", randomUUID(), decision);
  await assert.rejects(() => advance(), "another mission context cannot satisfy this lesson");
  const fail = { ...decision, allocation: { ...decision.allocation, svet: 0, tech: 100 } };
  assert.equal((await verifyMission(owner, "allocation-training-v1", randomUUID(), fail)).completed, false);
  await assert.rejects(() => advance());
  // A forged final cursor cannot bypass the final recheck either.
  await sql`insert into lesson_progress(user_id,lesson_id,status,last_position,updated_at) values(${owner},${lesson.id},'in_progress',1,now())`;
  await assert.rejects(() => completeLesson(owner, lesson.id));
  await sql`update lesson_progress set last_position=0 where user_id=${owner}`;
  const protectedRows = async () => ({ trades: await sql`select * from portfolio_trade`, portfolios: await sql`select * from portfolio`, awards: await sql`select * from lesson_award`, grants: await sql`select * from progression_unlock` });
  const before = await protectedRows();
  const request = randomUUID();
  const concurrent = await Promise.all(Array.from({ length: 5 }, () => verifyMission(owner, "allocation-training-v1", request, decision)));
  assert.ok(concurrent.every((result) => result.completed));
  assert.equal((await sql`select * from mission_attempt where user_id=${owner} and request_id=${request}`).length, 1);
  await assert.rejects(() => verifyMission(owner, "allocation-training-v1", request, fail));
  await assert.rejects(() => verifyMission(owner, "allocation-training-v1", randomUUID(), { ...decision, completed: true }));
  assert.deepEqual(await protectedRows(), before, "scenario/training must not mutate personal or reward data");
  await advance();
  const rewards = await Promise.all(Array.from({ length: 4 }, () => completeLesson(owner, lesson.id)));
  assert.equal(rewards.reduce((sum, reward) => sum + reward.xpAwarded, 0), 60);
  const completed = await sql`select * from lesson_progress where user_id=${owner}`;
  await save(owner, { lessonId: lesson.id, status: "in_progress", lastPosition: 0 });
  assert.deepEqual(await sql`select * from lesson_progress where user_id=${owner}`, completed);
  assert.equal((await completeLesson(owner, lesson.id)).xpAwarded, 0);
  assert.match((await verifyMission(personal, "ips-etf-purchase-v1", randomUUID())).message, /nemáš cvičný kapitál/);
  await sql`insert into progression_unlock(user_id,unlock_id,practice_capital_minor,reason,unlocked_at) values(${personal},'PORTFOLIO_LAB',500000,'legacy',now())`;
  const { saveLearnerArtifact } = await import("../src/features/artifacts/repository");
  const { exampleIps } = await import("../src/features/ips/test-fixtures");
  await saveLearnerArtifact(personal, { content: { kind: "investment_plan", payload: { ...exampleIps, allocation: { lines: [{ assetClass: "equity", weightBps: 8000 }], cashBps: 2000 } } }, sourceLessonId: null, consent: true, requestId: randomUUID() });
  assert.match((await verifyMission(personal, "ips-etf-purchase-v1", randomUUID())).message, /konkrétními instrumenty/);
  await saveLearnerArtifact(personal, { content: { kind: "investment_plan", payload: exampleIps }, sourceLessonId: null, consent: true, requestId: randomUUID() });
  const { getOrCreateActivePortfolio, executeTrade, resetActivePortfolio } = await import("../src/features/portfolio/repository");
  await getOrCreateActivePortfolio(personal);
  assert.equal((await verifyMission(personal, "ips-etf-purchase-v1", randomUUID())).completed, false);
  // The January sample's ETF observation is outside Xetra hours. This suite tests evidence,
  // not market sessions: supply an executable quote fixture without changing price/FX/fees.
  const { portfolioMarketData } = await import("../src/features/portfolio/environment");
  const originalQuote = portfolioMarketData.service.getQuote.bind(portfolioMarketData.service);
  portfolioMarketData.service.getQuote = async (id) => {
    const quote = await originalQuote(id);
    return { ...quote, usability: { ...quote.usability, usableForExecution: true } };
  };
  await executeTrade(personal, { instrumentId: "IE-XETR:VWCE", quantity: "0.1", side: "BUY", clientIdempotencyKey: randomUUID() });
  portfolioMarketData.service.getQuote = originalQuote;
  const purchaseResults = await Promise.all(Array.from({ length: 4 }, () => verifyMission(personal, "ips-etf-purchase-v1", randomUUID())));
  assert.ok(purchaseResults.every((result) => result.completed));
  assert.equal((await sql`select * from mission_attempt where user_id=${personal}`).length, 1);
  await assert.rejects(() => verifyMission(personal, "ips-etf-purchase-v1", randomUUID(), { tradeId: "forged" }));
  await resetActivePortfolio(personal, randomUUID());
  assert.equal(await hasCompletedMission(db, personal, "ips-etf-purchase-v1"), true);
  const claimRequest = randomUUID();
  await verifyMission(personal, "allocation-training-v1", claimRequest, fail);
  await verifyMission(guest, "allocation-training-v1", claimRequest, decision);
  const [guestAttempt] = await sql`select * from mission_attempt where user_id=${guest}`;
  const { claimGuestLearning } = await import("../src/features/guest/repository");
  const claims = await Promise.all(Array.from({ length: 4 }, () => claimGuestLearning(guest, personal)));
  assert.equal(claims.filter((claim) => claim.claimed).length, 1);
  assert.equal(await hasCompletedMission(db, personal, "allocation-training-v1"), true);
  const [claimedAttempt] = await sql`select * from mission_attempt where id=${guestAttempt.id}`;
  assert.deepEqual(claimedAttempt.evidence, guestAttempt.evidence);
  assert.deepEqual(claimedAttempt.created_at, guestAttempt.created_at);
  assert.equal(claimedAttempt.user_id, personal);
  assert.match(claimedAttempt.request_id, /^claim:/);
  assert.equal((await sql`select * from mission_attempt where user_id=${personal} and mission_id='allocation-training-v1'`).length, 2);
  const { buildAccountExport, readAccountExportRows } = await import("../src/features/account/export");
  assert.equal(buildAccountExport((await readAccountExportRows(db, owner))!).missionAttempts.length, 3);
  await sql`delete from "user" where id=${owner}`;
  assert.equal((await sql`select * from mission_attempt where user_id=${owner}`).length, 0);
  assert.equal(await hasCompletedMission(db, other, "allocation-training-v1"), true);
  console.log("PASS: migrations twice; server criteria; forged cursor/flags; owner isolation; concurrent retry idempotence; lesson/reward compatibility; real fractional ETF purchase + IPS; reset preservation; export/cascade; concurrent guest claim with retry-key collision; scenario isolation.");
} finally {
  lesson.blocks = originalBlocks; steps.splice(0, steps.length, ...originalSteps);
  await sql`delete from "user" where id in ${sql(ids)}`;
  await sql.end();
  await (globalThis as unknown as { client?: { end: () => Promise<void> } }).client?.end();
}
