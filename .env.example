DATABASE_URL="postgresql://postgres:postgres@localhost:5433/quantlearn"
BETTER_AUTH_SECRET="replace-with-a-48-character-minimum-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Bearer secret for Vercel Cron jobs (at least 32 characters). Unset locally keeps the cron endpoints closed.
CRON_SECRET=

# Transactional e-mail (password reset, e-mail verification) through Resend. Server-only.
# Explicit transport: resend (Vercel Production), outbox (local QA), log (local/Preview default).
# Vercel Preview refuses resend even if credentials are present.
# log prints links only under local `next dev`; hosted logs never contain links.
EMAIL_TRANSPORT=log
RESEND_API_KEY=
EMAIL_FROM="investi <ucet@mail.investnik.cz>"
# Local QA only: write e-mails as JSON files into this directory instead of sending them.
EMAIL_OUTBOX_DIR=

# Optional social sign-in. A provider is enabled only when BOTH values are set.
# Keep credentials server-only; never prefix them with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Security data: use "deterministic" locally or "fmp" for live FMP-backed reads.
MARKET_DATA_PROVIDER="deterministic"
# FX data: use "deterministic" locally, or keyless "cnb" (ČNB daily fixing, recommended) / "frankfurter" with FMP.
FX_DATA_PROVIDER="deterministic"
# Optional fixed UTC instant for deterministic market-session demos and browser QA.
DETERMINISTIC_MARKET_NOW=

# Server-only Financial Modeling Prep credential. Required when MARKET_DATA_PROVIDER="fmp".
FMP_API_KEY=

# Docker Compose uses these to initialise its isolated PostgreSQL container.
# Replace both placeholder values in your ignored .env before starting the stack.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace-with-a-local-postgres-password"
POSTGRES_DB="quantlearn"

# Opt-in server timing: set to 1 to print one "[investi:perf]" JSON line per route segment (durations, counts, SQL shapes; no parameters or identifiers).
# Leave empty in production. See docs/performance-baseline.md.
INVESTI_PERF_DEBUG=

# Emergency rollback for the Content-Security-Policy: "true" sends it as Report-Only (violations are reported, not blocked).
# Leave empty so the policy is enforced.
CSP_REPORT_ONLY=
